<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE listofactions SYSTEM "customActions.dtd">
<listofactions>
    <objecttype resourceBundle="com.ptc.windchill.enterprise.associativity.part.mpml.mapsb.mapsbActionsRB"
                name="extAction">
        <!--uiComoponent 判断权限-->
        <action name="testAction">
            <command url="/netmarkets/jsp/ext/ziang/test.jsp"
                     windowType="popup"/>
        </action>
    </objecttype>

    <objecttype name="work" class="wt.workflow.work.WorkItem">
        <!-- 保存任务 -->
        <action name="save" enabledwhensuspended="true" ajax="row" uicomponent="WORKITEM_SAVE">
            <command class="ext.ziang.workflow.CustomNmWorkItemCommands" method="save" onClick="EnableTextBox()"/>
        </action>

    </objecttype>

</listofactions>

